  "quick_publish_steps": [
    "1. WP admin > Pages > Add New",
    "2. Title: copy from rank_math_title above",
    "3. Slug: copy from slug field above (Settings > Permalinks must be /%postname%/)",
    "4. Paste markdown content from draft_file (Obsidian)",
    "5. Elementor: convert to Elementor template OR keep Gutenberg blocks (your call)",
    "6. Rank Math: paste rank_math_title + rank_math_desc + set Focus Keyword = target_kw",
    "7. Schema: LocalBusiness + Service (pillars) / Article (blogs)",
    "8. Featured image: from /assets/ folder (or skip)",
    "9. Preview > check on mobile + desktop",
    "10. Publish OR Save Draft (recommended first time)"
  ],
