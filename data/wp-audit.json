  "groups": [
    {
      "id": "blockers",
      "label": "🚨 Blockers — install before any pillar pages go live",
      "description": "These 4 items must be done Day 1 morning. Without them, the 6 pillar + 3 blog drafts will not rank and you may break existing content.",
      "items": [
        {
          "id": "WP-01",
          "task": "Backup site (UpdraftPlus / hosting panel)",
          "why": "Safety net before any change",
          "how": "Settings > UpdraftPlus, or cPanel/Cloudways backup",
          "time": "10 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-02",
          "task": "Install Rank Math SEO plugin",
          "why": "CRITICAL — no SEO plugin currently. The 6 pillar + 3 blog drafts all assume Rank Math for meta + schema + sitemap.",
          "how": "Plugins > Add New > search 'Rank Math SEO' > Install > Activate. Run setup wizard.",
          "time": "15 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-03",
          "task": "Set permalinks to /%postname%/",
          "why": "REQUIRED for pillar slugs like /local-seo-doctors-chandigarh/",
          "how": "Settings > Permalinks > Post name > Save",
          "time": "2 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-04",
          "task": "Change site title from PixelPierNYC to Prime Bridge Media",
          "why": "Brand confusion in Google + browser tab. Also update tagline.",
          "how": "Settings > General > Site Title: Prime Bridge Media > Tagline: Digital Marketing Agency in Chandigarh-Tricity",
          "time": "2 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        }
      ]
    },
    {
      "id": "critical_d1",
      "label": "🟠 Critical — do these on Day 1",
      "description": "Cleanup + security patches. Do all of these before publishing pillars/blogs.",
      "items": [
        {
          "id": "WP-05",
          "task": "Delete Breeze plugin",
          "why": "Conflicts with Object Cache Pro (only one can win)",
          "how": "Plugins > Installed Plugins > Breeze > Delete",
          "time": "2 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-06",
          "task": "Activate Akismet + get API key",
          "why": "Comment spam arrives within days of blog posts going live",
          "how": "Plugins > Installed > Akismet > Activate > Get free API key from akismet.com",
          "time": "10 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-07",
          "task": "Archive 66 demo items (26 pages + 40 posts)",
          "why": "PixelPierNYC demo content (artists, job posts) competes with Prime Bridge Media content in Google",
          "how": "Use Bulk Edit to change status to Draft for all PixelPierNYC items. OR install Post Status Notifier plugin.",
          "time": "30 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-08",
          "task": "Update Elementor Pro 4.1.3 to 4.2.1 (security)",
          "why": "Security patch. Backup first (WP-01).",
          "how": "Dashboard > Updates > Update Elementor Pro. Verify layouts intact after.",
          "time": "20 min",
          "priority": "P0",
          "done": false,
          "section": "wp_audit"
        }
      ]
    },
    {
      "id": "should_do",
      "label": "🟡 Should-do — finish in Week 1",
      "description": "Polish + housekeeping. Skip nothing critical if time-pressed.",
      "items": [
        {
          "id": "WP-09",
          "task": "Delete VamTam Importers + Hello Dolly plugins",
          "why": "VamTam Importers = demo content importer (no longer needed). Hello Dolly = useless.",
          "how": "Plugins > Installed > Delete both",
          "time": "2 min",
          "priority": "P1",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-10",
          "task": "Update VamTam Elementor Integration 1.1.20 to 1.1.21",
          "why": "Theme compatibility patch",
          "how": "Dashboard > Updates > Update. May require VamTam license for auto-update; manual upload otherwise.",
          "time": "10 min",
          "priority": "P1",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-11",
          "task": "Delete unused themes (keep active + 1 backup)",
          "why": "Site Health flagged: inactive themes = security risk",
          "how": "Appearance > Themes > select inactive > Delete",
          "time": "5 min",
          "priority": "P1",
          "done": false,
          "section": "wp_audit"
        },
        {
          "id": "WP-12",
          "task": "Upgrade PHP 8.2.33 to 8.3 on VPS",
          "why": "Site Health flagged. PHP 8.3 is faster + WordPress 7.0 recommends it.",
          "how": "SSH: sudo apt install php8.3 php8.3-fpm php8.3-mysql php8.3-xml php8.3-curl php8.3-mbstring, then switch FPM pool",
          "time": "30 min",
          "priority": "P1",
          "done": false,
          "section": "wp_audit"
        }
      ]
    },
    {
